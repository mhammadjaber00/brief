# Splunk MCP Server v1.1.2 connection
# Generate the token FROM INSIDE the MCP Server app — Settings -> Tokens is rejected.
SPLUNK_MCP_URL=https://localhost:8089/services/mcp
SPLUNK_MCP_TOKEN=

# Splunk Cloud (Hosted Models) — leave blank when running offline / CLI / GitHub Action
SPLUNK_CLOUD_HOST=
SPLUNK_CLOUD_TOKEN=

# Ollama (offline fallback) — only used when SPLUNK_CLOUD_HOST is unset
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
